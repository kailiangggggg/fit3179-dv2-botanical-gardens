{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A family-by-decade heatmap for the 9,683 PlantBank living-specimen records that have both a recorded plant family and a usable year. It describes the indexed record sample, not annual acquisition activity.",
  "data": {"url": "../data/plantbank_family_decades.csv", "format": {"type": "csv"}},
  "width": "container",
  "height": 300,
  "layer": [
    {"mark": {"type": "rect", "stroke": "#f8f6ee", "strokeWidth": 1}, "encoding": {"color": {"field": "record_count", "type": "quantitative", "title": "Records", "scale": {"scheme": "greens"}, "legend": {"orient": "bottom", "direction": "horizontal"}}}},
    {"transform": [{"filter": "datum.record_count > 0"}], "mark": {"type": "text", "fontSize": 10, "color": "#193b30"}, "encoding": {"text": {"field": "record_count", "type": "quantitative", "format": ",.0f"}}}
  ],
  "encoding": {
    "x": {"field": "decade_label", "type": "ordinal", "sort": {"field": "decade", "order": "ascending"}, "axis": {"title": "Recorded decade", "labelAngle": 0}},
    "y": {"field": "family", "type": "ordinal", "sort": {"field": "family_order", "order": "ascending"}, "axis": {"title": "Plant family", "labelLimit": 160}},
    "tooltip": [
      {"field": "family", "type": "nominal", "title": "Plant family"},
      {"field": "decade_label", "type": "ordinal", "title": "Decade"},
      {"field": "record_count", "type": "quantitative", "title": "Living-specimen records", "format": ",.0f"}
    ]
  },
  "config": {"view": {"stroke": null}}
}
