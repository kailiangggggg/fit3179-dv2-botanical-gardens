{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Equal-area hexagons aggregate Australian-coded top-level seed-bank accession origins. Each cell is 100 km across; cells with fewer than five records are suppressed. The polygons show collection origins, not garden or seed-bank locations.",
  "width": "container",
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "center": [132, -25],
    "parallels": [-18, -36]
  },
  "layer": [
    {
      "data": {
        "url": "../data/state_rates.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "fill": "#f1efe7", "stroke": "#b8c3bb", "strokeWidth": 0.65},
      "encoding": {"shape": {"field": "geometry", "type": "geojson"}}
    },
    {
      "data": {
        "url": "../data/ala_origin_hexes.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "stroke": "#fffdf7", "strokeWidth": 0.45, "opacity": 0.94},
      "encoding": {
        "shape": {"field": "geometry", "type": "geojson"},
        "color": {
          "field": "properties.record_count",
          "type": "quantitative",
          "title": "Origin records per 100 km cell",
          "scale": {"scheme": "ylgn", "type": "sqrt"},
          "legend": {"orient": "bottom", "direction": "horizontal", "format": ",.0f"}
        },
        "tooltip": [
          {"field": "properties.record_count", "type": "quantitative", "title": "Top-level origin records in cell", "format": ",.0f"}
        ]
      }
    }
  ]
}
