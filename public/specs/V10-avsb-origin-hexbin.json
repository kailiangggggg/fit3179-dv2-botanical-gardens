{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Equal-area hexagons aggregate Australian-coded top-level seed-bank accession origins. Each cell is 100 km across; cells with fewer than five records are suppressed. A logarithmic color scale spans the published range of 5–2,629 records so sparse bins remain visible. The polygons show collection origins, not garden or seed-bank locations.",
  "width": 900,
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "center": [132, -25],
    "parallels": [-18, -36],
    "scale": {"signal": "min(615, width * 1.55)"},
    "translate": {"signal": "[width / 2, 206]"}
  },
  "layer": [
    {
      "data": {
        "url": "../data/state_rates.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "fill": "#f1efe7", "stroke": "#b8c3bb", "strokeWidth": 0.65},
      "encoding": {"shape": {"field": "geometry", "type": "geojson"}}
    },
    {
      "data": {
        "url": "../data/ala_origin_hexes.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "stroke": "#fffdf7", "strokeWidth": 0.45, "opacity": 0.94},
      "encoding": {
        "shape": {"field": "geometry", "type": "geojson"},
        "color": {
          "field": "properties.record_count",
          "type": "quantitative",
          "title": "Origin records per 100 km cell",
          "scale": {"type": "log", "domain": [5, 2629], "clamp": true, "range": ["#5a8e91", "#154664"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "format": ",.0f", "values": [5, 20, 100, 500, 2629]}
        },
        "tooltip": [
          {"field": "properties.record_count", "type": "quantitative", "title": "Top-level origin records in cell", "format": ",.0f"}
        ]
      }
    }
  ]
}
