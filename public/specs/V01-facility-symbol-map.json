{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Known Geoscience Australia botanical garden and arboretum features. Projected positions show location, four graduated circle sizes show registered-area classes, and hue distinguishes the two register types. A/B anchor markers locate the centres of the selected Sydney and Melbourne windows, with leaders to their labels. Tooltips retain each reported area in hectares.",
  "width": 900,
  "height": 430,
  "projection": {
    "type": "equalEarth",
    "center": [
      132,
      -25
    ],
    "scale": {
      "signal": "min(615, width * 1.55)"
    },
    "translate": {
      "signal": "[width / 2, 206]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "../data/state_rates.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.state_code !== '9'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe7",
        "stroke": "#b8c3bb",
        "strokeWidth": 0.65
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "../data/v01_detail_locator_geometry.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.kind === 'leader'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#34443a",
        "strokeWidth": 1,
        "opacity": 0.92
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "../data/facility_points.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.area_hectares < 10 ? '0–<10 ha' : datum.properties.area_hectares < 100 ? '10–<100 ha' : datum.properties.area_hectares < 1000 ? '100–<1,000 ha' : '≥1,000 ha'",
          "as": "registered_area_class"
        }
      ],
      "params": [
        {
          "name": "facilityHover",
          "select": {
            "type": "point",
            "fields": [
              "properties.feature_name"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 1,
        "stroke": "#fffdf7",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "properties.longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "registered_area_class",
          "type": "nominal",
          "title": "Registered area class",
          "sort": [
            "0–<10 ha",
            "10–<100 ha",
            "100–<1,000 ha",
            "≥1,000 ha"
          ],
          "scale": {
            "type": "ordinal",
            "domain": [
              "0–<10 ha",
              "10–<100 ha",
              "100–<1,000 ha",
              "≥1,000 ha"
            ],
            "range": [
              12,
              24,
              48,
              96
            ]
          },
          "legend": {
            "title": "Registered area class",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              "0–<10 ha",
              "10–<100 ha",
              "100–<1,000 ha",
              "≥1,000 ha"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "facilityHover",
            "empty": false,
            "value": 0.98
          },
          "value": 0.78
        },
        "color": {
          "field": "properties.feature_subtype",
          "type": "nominal",
          "title": "Register type",
          "scale": {
            "domain": [
              "Botanic Garden",
              "Arboretum"
            ],
            "range": [
              "#003F5C",
              "#B85C00"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "properties.feature_name",
            "type": "nominal",
            "title": "Facility"
          },
          {
            "field": "properties.feature_subtype",
            "type": "nominal",
            "title": "Register type"
          },
          {
            "field": "properties.locality",
            "type": "nominal",
            "title": "Locality"
          },
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "properties.area_hectares",
            "type": "quantitative",
            "title": "Registered area (ha)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "../data/v01_detail_locator_geometry.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.kind === 'anchor'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "square",
        "size": 260,
        "stroke": "#34443a",
        "strokeWidth": 1.8,
        "fillOpacity": 0
      },
      "encoding": {
        "longitude": {
          "field": "properties.longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#fffdf7"
        }
      }
    },
    {
      "data": {
        "url": "../data/v01_detail_locator_geometry.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.kind === 'anchor'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "font": "Source Sans 3",
        "fontSize": 10.5,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "properties.longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "properties.locator_id",
          "type": "nominal"
        },
        "color": {
          "value": "#34443a"
        }
      }
    },
    {
      "data": {
        "url": "../data/v01_detail_locator_geometry.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.kind === 'label'"
        }
      ],
      "mark": {
        "type": "text",
        "align": {"expr": "datum.properties.label_align"},
        "baseline": "middle",
        "dx": {"expr": "datum.properties.label_align === 'left' ? 7 : -7"},
        "dy": -4,
        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "properties.longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "properties.place_label",
          "type": "nominal"
        },
        "color": {
          "value": "#34443a"
        }
      }
    }
  ]
}
