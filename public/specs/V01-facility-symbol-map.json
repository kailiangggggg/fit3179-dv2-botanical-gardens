{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jurisdiction-level proportional-symbol map of the 182 Geoscience Australia register facilities. Circle area, not radius, represents each jurisdiction's known facility count. Symbol anchors are representative jurisdiction locations, not individual gardens.",
  "width": 900,
  "height": 440,
  "projection": {
    "type": "equalEarth",
    "center": [132, -25],
    "scale": {"signal": "min(615, width * 1.55)"},
    "translate": {"signal": "[width / 2, 210]"}
  },
  "layer": [
    {
      "data": {"url": "../data/state_rates.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [{"filter": "datum.properties.state_code !== '9'"}],
      "mark": {"type": "geoshape", "fill": "#efeee7", "stroke": "#aebbb1", "strokeWidth": 0.75},
      "encoding": {"shape": {"field": "geometry", "type": "geojson"}}
    },
    {
      "data": {
        "url": "../data/v01_jurisdiction_counts.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [{"filter": "datum.properties.facility_count < 24"}],
      "mark": {"type": "rule", "stroke": "#68796e", "strokeWidth": 0.9, "opacity": 0.85},
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "longitude2": {"field": "properties.label_longitude", "type": "quantitative"},
        "latitude2": {"field": "properties.label_latitude", "type": "quantitative"}
      }
    },
    {
      "data": {
        "url": "../data/v01_jurisdiction_counts.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "circle", "filled": true, "fill": "#176247", "stroke": "#fffdf7", "strokeWidth": 1.4, "opacity": 0.97},
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "size": {
          "field": "properties.facility_count",
          "type": "quantitative",
          "title": "Known facilities (circle area)",
          "scale": {"type": "linear", "domain": [0, 50], "range": [0, 2000], "zero": true, "nice": false},
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [10, 25, 50],
            "title": "Known facilities · circle area",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "symbolFillColor": "#176247",
            "symbolStrokeColor": "#fffdf7",
            "symbolStrokeWidth": 1
          }
        },
        "tooltip": [
          {"field": "properties.state", "type": "nominal", "title": "Jurisdiction"},
          {"field": "properties.facility_count", "type": "quantitative", "title": "Known register facilities", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {
        "url": "../data/v01_jurisdiction_counts.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [{"filter": "datum.properties.facility_count >= 24"}],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "dy": -5, "font": "Source Sans 3", "fontSize": 11, "fontWeight": 700, "color": "#fffdf7"},
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "text": {"field": "properties.abbreviation", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "../data/v01_jurisdiction_counts.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [{"filter": "datum.properties.facility_count >= 24"}],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "dy": 8, "font": "Source Sans 3", "fontSize": 10, "fontWeight": 700, "color": "#fffdf7"},
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "text": {"field": "properties.facility_count", "type": "quantitative", "format": ",.0f"}
      }
    },
    {
      "data": {
        "url": "../data/v01_jurisdiction_counts.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [{"filter": "datum.properties.facility_count < 24"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "font": "Source Sans 3", "fontSize": 12, "fontWeight": 600, "color": "#202a27", "clip": false},
      "encoding": {
        "longitude": {"field": "properties.label_longitude", "type": "quantitative"},
        "latitude": {"field": "properties.label_latitude", "type": "quantitative"},
        "text": {"field": "properties.label", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
